{
  "$schema": "https://www.designtokens.org/schema/",
  "base": {
    "color": {
      "paper": { "0": { "$type": "color", "$value": "#ffffff" } },
      "night": { "1": { "$type": "color", "$value": "#14181e" } }
    },
    "space": { "4": { "$type": "dimension", "$value": "16px" } },
    "font": {
      "family": {
        "sans": { "$type": "fontFamily", "$value": ["IBM Plex Sans", "system-ui", "sans-serif"] }
      },
      "weight": { "medium": { "$type": "fontWeight", "$value": 500 } }
    },
    "opacity": { "disabled": { "$type": "opacity", "$value": 0.45 } },
    "duration": { "quick": { "$type": "duration", "$value": "120ms" } }
  },
  "light": {
    "surface": { "canvas": { "$type": "color", "$value": "{base.color.paper.0}" } },
    "shadow": {
      "raised": {
        "$type": "shadow",
        "$value": {
          "color": "#1c233022",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px"
        }
      }
    }
  },
  "dark": {
    "surface": { "canvas": { "$type": "color", "$value": "{base.color.night.1}" } },
    "shadow": {
      "raised": {
        "$type": "shadow",
        "$value": {
          "color": "#00000055",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "8px",
          "spread": "0px"
        }
      }
    }
  },
  "$themes": [
    {
      "name": "Light",
      "group": "Mode",
      "selectedTokenSets": { "base": "source", "light": "enabled" }
    },
    {
      "name": "Dark",
      "group": "Mode",
      "selectedTokenSets": { "base": "source", "dark": "enabled" }
    }
  ]
}
