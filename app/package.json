{
  "name": "@innytypes/app",
  "productName": "InnyTypes",
  "version": "0.0.0",
  "private": true,
  "description": "The new InnyTypes application: the shell, the runtime and the services process (plan 0018).",
  "license": "MIT",
  "type": "module",
  "main": "dist/shell/main.cjs",
  "scripts": {
    "types": "tsc -b",
    "build": "esbuild src/shell/main.ts src/runtime/main.ts src/services/main.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outbase=src --outdir=dist --out-extension:.js=.cjs --log-level=warning",
    "architecture": "depcruise src --config .dependency-cruiser.cjs && eslint --config eslint.architecture.config.mjs src",
    "test:unit": "vitest run --project unit --project integration --coverage",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "vitest": "5.0.2"
  }
}
