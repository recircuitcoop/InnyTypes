{
  "name": "@innytypes/app",
  "productName": "InnyTypes",
  "version": "0.0.0",
  "private": true,
  "description": "The new InnyTypes application: the shell, the runtime and the services process (plan 0018).",
  "license": "MIT",
  "type": "module",
  "main": "dist/shell/main.cjs",
  "scripts": {
    "types": "tsc -b",
    "build": "npm run build:processes && npm run build:pages && npm run build:editor",
    "build:processes": "esbuild src/shell/main.ts src/shell/preload.ts src/runtime/main.ts src/services/main.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --external:node-red --external:express --external:@node-red/nodes --outbase=src --outdir=dist --out-extension:.js=.cjs --log-level=warning",
    "build:pages": "esbuild src/ui/pages/status.ts src/ui/pages/status.html --bundle --platform=browser --target=chrome140 --format=iife --loader:.html=copy --outbase=src --outdir=dist --log-level=warning",
    "build:editor": "esbuild src/adapters/nodered/editor-forms.ts --bundle --minify --platform=browser --target=chrome140 --format=iife --outfile=dist/nodered/editor-forms.js --log-level=warning",
    "architecture": "depcruise src --config .dependency-cruiser.cjs && eslint --config eslint.architecture.config.mjs src",
    "test:unit": "vitest run --project unit --project integration --coverage",
    "test:conformance": "vitest run --project conformance",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "4.17.25",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "ajv": "8.20.0",
    "express": "4.22.2",
    "node-red": "5.0.7"
  }
}
