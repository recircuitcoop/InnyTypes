{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    // The UI is React with the automatic runtime (plan 0022 §J): .tsx compiles without importing React.
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    // The sdk-ts conformance fixtures (WI-0018-26) import sdk/ts/src/node.ts with its literal
    // extension, because Node's own type-stripping runtime resolves relative ESM specifiers
    // exactly as written and requires one. packages/anytype's extensionless import of the
    // same module keeps working: this only adds what an explicit ".ts" specifier needs.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test", "*.ts"],
  "exclude": ["dist", "coverage", "test-results"]
}
