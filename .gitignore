# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Briefcase — the bundles are BUILT from the committed configuration and icons, never
# committed themselves: `.briefcase/` is its cache and dev environment, `build/` and `dist/`
# are its output, and `src/*.dist-info/` is the metadata `briefcase dev` writes beside the
# sources so an unpackaged run can read its own version.
.briefcase/
src/*.dist-info/
# `logs/` is where Briefcase drops a detailed log when a build fails; it is output too.
logs/

# Environments — the gate rebuilds this from uv.lock, it is never committed.
.venv/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
docs/loop/.scratch/
e2e-artifacts/
.coverage
.coverage.*
.DS_Store

# Node — the Anytype MCP server is installed, never vendored. package-lock.json IS committed.
node_modules/
npm-debug.log*
# npm is the package manager here; a Bun lockfile is a stray from running `bun install`.
bun.lockb
bun.lock

# The new application (plan 0018): build output, test output and the gate's own reports.
app/dist/
app/coverage/
app/test-results/
app/playwright-report/
*.tsbuildinfo
.gate/

# Packaging (WI-0018-23): tools/runtimes/fetch.mjs's fetched runtimes and electron-builder's
# scratch resources both land under app/build/, already covered by the Python `build/` rule
# above; electron-builder's packaged artefacts (dmg, zip, AppImage, deb) land in app/release/.
app/release/

# Loop engine worktrees
.claude/worktrees/

# Secrets. The Anytype API key lives in the user's own config or environment and must
# never reach the tree. The rule belongs here before a file appears, not after.
.env
*.key
credentials.toml
